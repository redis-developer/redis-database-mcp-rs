{
  "catalog": [
    {
      "bundle": "raw",
      "name": "redis_command",
      "protocol": {
        "annotations": {},
        "description": "Run a classified or explicitly unrestricted Redis request/response command. Connection-state, streaming, transaction, script, and blocking forms are rejected.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "arguments": {
              "default": [],
              "description": "Command arguments in order.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "command": {
              "description": "Redis command name, without arguments.",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "title": "RawCommandInput",
          "type": "object"
        },
        "name": "redis_command",
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            },
            "value": true
          },
          "required": [
            "command",
            "value"
          ],
          "title": "RawCommandOutput",
          "type": "object"
        },
        "title": "Run Redis Command"
      },
      "required_access": "full",
      "requires_raw_opt_in": true
    },
    {
      "bundle": "essentials",
      "name": "redis_dbsize",
      "protocol": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "readOnlyHint": true
        },
        "description": "Count keys in the selected Redis database.",
        "inputSchema": {
          "additionalProperties": false,
          "type": "object"
        },
        "name": "redis_dbsize",
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "key_count": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "key_count"
          ],
          "title": "DbsizeOutput",
          "type": "object"
        },
        "title": "Redis Database Size"
      },
      "required_access": "read_only",
      "requires_raw_opt_in": false
    },
    {
      "bundle": "essentials",
      "name": "redis_del",
      "protocol": {
        "annotations": {
          "idempotentHint": true
        },
        "description": "Permanently delete one or more Redis keys. Requires full access.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "keys": {
              "description": "Redis keys to delete.",
              "items": {
                "type": "string"
              },
              "maxItems": 1000,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "keys"
          ],
          "title": "DelInput",
          "type": "object"
        },
        "name": "redis_del",
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "deleted": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "requested": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "requested",
            "deleted"
          ],
          "title": "DelOutput",
          "type": "object"
        },
        "title": "Delete Redis Keys"
      },
      "required_access": "full",
      "requires_raw_opt_in": false
    },
    {
      "bundle": "essentials",
      "name": "redis_get",
      "protocol": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "readOnlyHint": true
        },
        "description": "Read a Redis string value. Binary data is returned as base64.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "key": {
              "description": "Redis key.",
              "type": "string"
            }
          },
          "required": [
            "key"
          ],
          "title": "KeyInput",
          "type": "object"
        },
        "name": "redis_get",
        "outputSchema": {
          "$defs": {
            "ValueEncoding": {
              "enum": [
                "utf8",
                "base64"
              ],
              "type": "string"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ValueEncoding"
                },
                {
                  "type": "null"
                }
              ]
            },
            "exists": {
              "type": "boolean"
            },
            "key": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "key",
            "exists"
          ],
          "title": "GetOutput",
          "type": "object"
        },
        "title": "Get Redis String"
      },
      "required_access": "read_only",
      "requires_raw_opt_in": false
    },
    {
      "bundle": "diagnostics",
      "name": "redis_info",
      "protocol": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "readOnlyHint": true
        },
        "description": "Read Redis server information and statistics, optionally for one INFO section.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "section": {
              "default": null,
              "description": "Optional INFO section, such as server, memory, stats, or replication.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "title": "InfoInput",
          "type": "object"
        },
        "name": "redis_info",
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "properties": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "raw": {
              "type": "string"
            },
            "section": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "properties",
            "raw"
          ],
          "title": "InfoOutput",
          "type": "object"
        },
        "title": "Redis Server Info"
      },
      "required_access": "read_only",
      "requires_raw_opt_in": false
    },
    {
      "bundle": "essentials",
      "name": "redis_ping",
      "protocol": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "readOnlyHint": true
        },
        "description": "Test the configured Redis connection and report round-trip latency.",
        "inputSchema": {
          "additionalProperties": false,
          "type": "object"
        },
        "name": "redis_ping",
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "latency_ms": {
              "format": "double",
              "type": "number"
            },
            "response": {
              "type": "string"
            }
          },
          "required": [
            "response",
            "latency_ms"
          ],
          "title": "PingOutput",
          "type": "object"
        },
        "title": "Ping Redis"
      },
      "required_access": "read_only",
      "requires_raw_opt_in": false
    },
    {
      "bundle": "essentials",
      "name": "redis_scan",
      "protocol": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "readOnlyHint": true
        },
        "description": "Read one non-blocking SCAN page. Pass the returned cursor to continue.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "count": {
              "default": 100,
              "description": "Approximate number of keys Redis should inspect in this page.",
              "format": "uint",
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            "cursor": {
              "default": 0,
              "description": "Cursor returned by the previous scan. Start with zero.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "key_type": {
              "default": null,
              "description": "Optional Redis key type filter.",
              "type": [
                "string",
                "null"
              ]
            },
            "pattern": {
              "default": "*",
              "description": "Glob-style key pattern.",
              "type": "string"
            }
          },
          "title": "ScanInput",
          "type": "object"
        },
        "name": "redis_scan",
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "count": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "cursor": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "keys": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "cursor",
            "keys",
            "count"
          ],
          "title": "ScanOutput",
          "type": "object"
        },
        "title": "Scan Redis Keys"
      },
      "required_access": "read_only",
      "requires_raw_opt_in": false
    },
    {
      "bundle": "essentials",
      "name": "redis_set",
      "protocol": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true
        },
        "description": "Set a UTF-8 Redis string, optionally with an expiration.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "expires_in_seconds": {
              "default": null,
              "description": "Optional expiration in seconds.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "key": {
              "description": "Redis key.",
              "type": "string"
            },
            "value": {
              "description": "UTF-8 value to store.",
              "type": "string"
            }
          },
          "required": [
            "key",
            "value"
          ],
          "title": "SetInput",
          "type": "object"
        },
        "name": "redis_set",
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "expires_in_seconds": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "key": {
              "type": "string"
            },
            "stored": {
              "type": "boolean"
            }
          },
          "required": [
            "key",
            "stored"
          ],
          "title": "SetOutput",
          "type": "object"
        },
        "title": "Set Redis String"
      },
      "required_access": "read_write",
      "requires_raw_opt_in": false
    },
    {
      "bundle": "essentials",
      "name": "redis_ttl",
      "protocol": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "readOnlyHint": true
        },
        "description": "Read a key TTL in seconds, including whether it is missing or persistent.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "key": {
              "description": "Redis key.",
              "type": "string"
            }
          },
          "required": [
            "key"
          ],
          "title": "KeyInput",
          "type": "object"
        },
        "name": "redis_ttl",
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "exists": {
              "type": "boolean"
            },
            "key": {
              "type": "string"
            },
            "persistent": {
              "type": "boolean"
            },
            "ttl_seconds": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "key",
            "ttl_seconds",
            "exists",
            "persistent"
          ],
          "title": "TtlOutput",
          "type": "object"
        },
        "title": "Redis Key TTL"
      },
      "required_access": "read_only",
      "requires_raw_opt_in": false
    },
    {
      "bundle": "essentials",
      "name": "redis_type",
      "protocol": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "readOnlyHint": true
        },
        "description": "Read the Redis data type of a key.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "key": {
              "description": "Redis key.",
              "type": "string"
            }
          },
          "required": [
            "key"
          ],
          "title": "KeyInput",
          "type": "object"
        },
        "name": "redis_type",
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "key_type": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "key_type"
          ],
          "title": "TypeOutput",
          "type": "object"
        },
        "title": "Redis Key Type"
      },
      "required_access": "read_only",
      "requires_raw_opt_in": false
    }
  ],
